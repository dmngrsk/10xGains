{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/assets/favicon/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/*.css",
          "/*.js",
          "!/env.js"
        ]
      }
    },
    {
      "name": "notification-icons",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/assets/favicon/web-app-manifest-192x192.png",
          "/assets/favicon/notification-badge.png"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "runtime-config",
      "urls": [
        "/env.js"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "1h",
        "timeout": "3s"
      }
    }
  ]
}
