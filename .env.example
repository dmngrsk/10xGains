# Copy to .env and fill in. The dev container writes this file for you; see README.md otherwise.

# ─── Local Supabase stack ─────────────────────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<local supabase publishable key from `supabase start`>
SUPABASE_SECRET_KEY=<local supabase secret key from `supabase start`>

# Google credentials are optional — leave blank to skip local Google sign-in.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Only for `pnpm infra:apply` / `infra:destroy`. Per-environment values go in .env.<environment>.
SUPABASE_ACCESS_TOKEN=<personal access token from https://supabase.com/dashboard/account/tokens>
SUPABASE_ORGANIZATION_ID=<organization id from `supabase orgs list`>
SUPABASE_DB_PASSWORD=<database password for the Terraform-managed Supabase project>

# ─── End-to-end tests ─────────────────────────────────────────────────────────────────────────
CYPRESS_BASE_URL=http://localhost:4200
CYPRESS_DEFAULT_COMMAND_TIMEOUT=10000
CYPRESS_ENVIRONMENT=development
APP_CANARY_USER_EMAIL=canary@10xgains.com
APP_CANARY_USER_PASSWORD=<canary user password>
APP_DEV_USER_EMAIL=dev@10xgains.com
APP_DEV_USER_PASSWORD=10xGains!
